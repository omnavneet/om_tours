# MongoDB Connection URI
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/om_tours?retryWrites=true&w=majority
# Or local: mongodb://localhost:27017/om_tours
MONGODB_URI="your_mongodb_uri_here"

# NextAuth Configuration
# The base URL of your application (usually http://localhost:3000 for local development)
NEXTAUTH_URL="http://localhost:3000"
# A random, high-entropy secret string to sign/encrypt NextAuth sessions and tokens
# You can generate one via command line: openssl rand -base64 32
NEXTAUTH_SECRET="your_nextauth_secret_here"

# Google Maps API Keys
# Public API Key used for loading Google Maps script in layout (e.g. Map/Places autocomplete)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="your_google_maps_api_key_here"
# Google Maps API Key referenced in TravelRoute component
NEXT_PUBLIC_GOOGLE_MAPS_API="your_google_maps_api_here"
